# Alice IDE Backend — Environment Variables
# Copy this file to .env and fill in your values

# YandexGPT API credentials (required for production mode)
# Get your keys at https://cloud.yandex.ru
ALICE_YANDEX_CLOUD_API_KEY=
ALICE_YANDEX_CLOUD_FOLDER_ID=

# Optional: Custom model URIs
# ALICE_YANDEX_GPT_MODEL_URI=gpt://your-folder-id/yandexgpt/latest
# ALICE_YANDEX_EMBEDDINGS_MODEL_URI=emb://your-folder-id/text-search-doc/latest

# Server settings
ALICE_HOST=0.0.0.0
ALICE_PORT=8090
ALICE_WORKSPACE_ROOT=/workspace

# Model parameters
ALICE_TEMPERATURE=0.3
ALICE_MAX_CONTEXT_TOKENS=8000
ALICE_MAX_COMPLETION_TOKENS=4000
