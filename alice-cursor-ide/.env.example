# Required for YandexGPT
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
# Alternative auth method:
# YANDEX_IAM_TOKEN=

# Optional model override.
# Default: gpt://<YANDEX_FOLDER_ID>/yandexgpt-lite/latest
YANDEX_MODEL_URI=

# Optional tuning
YANDEX_TIMEOUT_SECONDS=120
ALICE_IDE_DEBUG=false

# RAG settings
ALICE_IDE_RAG_CHUNK_LINES=80
ALICE_IDE_RAG_CHUNK_OVERLAP=12
ALICE_IDE_RAG_CONTEXT_CHUNKS=5
ALICE_IDE_RAG_MAX_FILES=1200
ALICE_IDE_RAG_MAX_FILE_SIZE_BYTES=350000
# ALICE_IDE_RAG_EXTENSIONS=.py,.ts,.tsx,.js,.jsx,.json,.md
